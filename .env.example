# Copia este archivo a ".env" y ajusta los valores. ".env" nunca se versiona en Git.

DB_ROOT_PASSWORD=changeme_root
DB_NAME=fantasy_clase
DB_USER=fantasy_app
DB_PASSWORD=changeme_app

# Clave de firma de los tokens JWT — genera una propia, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme_jwt_secret

LOG_LEVEL=INFO
